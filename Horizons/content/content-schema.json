{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brighton.local/horizons/content-schema.json",
  "title": "Horizons lesson content",
  "type": "object",
  "required": ["course", "level", "unit", "lesson", "title", "objectives", "pages"],
  "properties": {
    "course": { "const": "Horizons" },
    "level": { "const": "A1" },
    "unit": { "type": "integer", "minimum": 1, "maximum": 8 },
    "lesson": { "type": "string", "pattern": "^[ABCD]$" },
    "title": { "type": "string" },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "real_world_context": { "type": "string" },
    "archetype": {
      "enum": ["standard", "photo-led", "reading-feature", "interview", "quiz", "real-world", "process", "collage"]
    },
    "spread_density": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "enum": ["light", "medium", "dense"] }
    },
    "pages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "exercises"],
        "properties": {
          "role": { "enum": ["opener", "continuation"] },
          "exercises": {
            "type": "array",
            "items": { "$ref": "#/$defs/exercise" }
          },
          "page_end": { "$ref": "#/$defs/pageEnd" }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "audio": {
      "type": "array",
      "items": { "$ref": "#/$defs/audio" }
    }
  },
  "$defs": {
    "exercise": {
      "type": "object",
      "required": ["id", "number", "instruction", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^HZN-A1-U[0-9]{2}-L[A-D]-E[0-9]{2}$" },
        "number": { "type": "integer", "minimum": 1 },
        "instruction": { "type": "string" },
        "type": {
          "enum": ["vocabulary", "reading", "listening", "grammar", "pronunciation", "speaking", "writing", "real-world", "review", "mixed"]
        },
        "layout": {
          "enum": ["plain", "questions-2", "questions-3", "photo-strip", "feature-sheet", "article-panel", "quiz-panel", "process-strip", "collage", "ui-recreation", "custom"]
        },
        "content": { "type": ["object", "array", "string"] },
        "audio_id": { "type": "string" },
        "asset_ids": { "type": "array", "items": { "type": "string" } },
        "answer_key": { "type": ["object", "array", "string", "null"] }
      }
    },
    "pageEnd": {
      "type": "object",
      "required": ["type", "prompt"],
      "properties": {
        "type": { "enum": ["communication", "digital", "reflection", "reference"] },
        "prompt": { "type": "string" },
        "audio_id": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "type", "status", "crop_intent"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["photo", "generated-raster", "icon", "ui-raster"] },
        "status": { "enum": ["placeholder", "sourced", "approved", "final"] },
        "crop_intent": { "type": "string" },
        "source": { "type": "string" },
        "creator": { "type": "string" },
        "license": { "type": "string" },
        "local_file": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["id", "printed_track", "script", "status"],
      "properties": {
        "id": { "type": "string" },
        "printed_track": { "type": "string" },
        "script": { "type": "string" },
        "speakers": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["draft", "approved", "generated", "final"] },
        "filename": { "type": "string" }
      }
    }
  }
}
